# ============================================================
# KeeperPilot environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---------- App ----------
APP_ENV=development
DEBUG=true

# ---------- Database (PostgreSQL) ----------
POSTGRES_USER=keeperpilot
POSTGRES_PASSWORD=keeperpilot
POSTGRES_DB=keeperpilot
DATABASE_URL=postgresql+asyncpg://keeperpilot:keeperpilot@localhost:5432/keeperpilot

# ---------- AI Agent (OpenAI) ----------
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# ---------- KeeperHub (execution layer) ----------
# Mock mode is the default for local dev: no real blockchain interaction.
# Set KEEPERHUB_MOCK=false and provide a real org API key to go live.
KEEPERHUB_MOCK=true
KEEPERHUB_API_KEY=kh_your_org_key
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
# Direct-execution REST base (used by status polling when not in mock mode)
KEEPERHUB_API_BASE=https://app.keeperhub.com/api
# Default execution network (11155111 = Ethereum Sepolia testnet)
KEEPERHUB_CHAIN_ID=11155111
# MCP client behavior (real mode): timeouts, retries, receipt polling.
# Retry is exponential: backoff * 2^attempt with jitter.
KEEPERHUB_REQUEST_TIMEOUT=30.0
KEEPERHUB_MAX_RETRIES=3
KEEPERHUB_RETRY_BACKOFF=1.0
KEEPERHUB_POLL_INTERVAL=2.0
KEEPERHUB_POLL_MAX_ATTEMPTS=5
# Market data (real mode): max DefiLlama pools considered, default gas estimate.
KEEPERHUB_MARKET_MAX_POOLS=20
KEEPERHUB_DEFAULT_GAS_USD=2.0

# ---------- Telegram notifications ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Auth ----------
# Set a long random value in real deployments.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-please-32-bytes-min
JWT_EXPIRES_MINUTES=1440
# Wallet ownership challenge lifetime in minutes.
CHALLENGE_TTL_MINUTES=10

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
# CORS origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
